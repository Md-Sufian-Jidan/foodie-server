model Review {
    id        String   @id @default(uuid())
    rating    Int
    comment   String?
    userId    String
    user      User     @relation(fields: [userId], references: [id])
    mealId    String
    meal      Meal     @relation(fields: [mealId], references: [id])
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("review")
}
